PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/veritas

# Firebase Admin (set GOOGLE_APPLICATION_CREDENTIALS or FIREBASE_SERVICE_ACCOUNT_PATH)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Or disable auth for local dev only:
# DISABLE_AUTH=true
# DEV_USER_ID=local_dev_user

# Gemini / LangChain
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Chroma server (run: chroma run --path ./chroma_db)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_TRUSTED_COLLECTION=veritas_trusted_sources

# Web search (at least one recommended)
SERPAPI_API_KEY=
SERPER_API_KEY=

# Frontend URL for share links
PUBLIC_APP_URL=http://localhost:5173

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# Limits
JSON_BODY_LIMIT=1mb
URL_FETCH_TIMEOUT_MS=15000
WEB_SEARCH_TIMEOUT_MS=12000

# Rate limits (per IP, per minute)
RATE_LIMIT_WRITE_PER_MIN=20
RATE_LIMIT_READ_PER_MIN=120
